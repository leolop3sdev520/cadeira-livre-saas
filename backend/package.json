{
  "name": "cadeira-livre",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de agendamentos com constraint de exclusão no PostgreSQL",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server/index.ts",
    "start": "node src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --env-file=.env",
    "db:migrate": "dbmate --env-file .env up",
    "db:rollback": "dbmate --env-file .env rollback",
    "db:new": "dbmate new",
    "db:seed:dev": "node --env-file=.env db/seeds/dev.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^10.2.6",
    "@fastify/multipart": "^10.1.7",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^6.0.1",
    "postgres": "^3.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.2.0",
    "typescript": "^5.7.0"
  }
}